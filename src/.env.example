# Flask session secret. Use a long random value in production.
ANIVERSE_SECRET_KEY=replace-with-a-long-random-secret

# QQ Mail SMTP sender configuration.
# Enable SMTP in QQ Mail and use the generated authorization code here,
# NOT your QQ account password.
QQ_MAIL_USERNAME=your_qq_number@qq.com
QQ_MAIL_AUTH_CODE=replace-with-qq-smtp-authorization-code
QQ_SMTP_HOST=smtp.qq.com
QQ_SMTP_PORT=465

# Keep 0 when exposing the site to the Internet.
FLASK_DEBUG=0

# Optional transactional SMTP provider. Nonempty values override QQ settings.
# SMTP_HOST=smtp.your-provider.example
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USERNAME=your-provider-username
# SMTP_PASSWORD=your-provider-password
# SMTP_FROM_EMAIL=no-reply@your-verified-domain.example
# SMTP_FROM_NAME=AniVerse
# SMTP_TIMEOUT=10
